# in production, do not include HOST_DATABSE_URL
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_PORT="5432"
POSTGRES_HOST="postgres_db"
DATABASE_URL="postgresql://postgres:postgres@postgres_db:5432/ledger?sslmode=prefer"
HOST_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/ledger" # URL for scripts run directly on your computer (needed for importer cli to work locally)
POSTGRES_DB="ledger"
POSTGRES_SSLMODE="prefer"
AWS_REQUEST_CHECKSUM_CALCULATION="when_required"
AWS_RESPONSE_CHECKSUM_VALIDATION="when_required"
#FRED_API_KEY=
#DATACOMMONS_API_KEY=